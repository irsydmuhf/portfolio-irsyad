# Supabase — public project credentials (PRD §51)
# Copy to .env.local for development; set the same keys in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Leave unset unless a server-side operation strictly needs it.
# NEVER prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Local migration runner (scripts/apply-migrations.mjs) — session-mode connection string
# from Supabase Dashboard → Connect → Session pooler. Never expose this value.
# SUPABASE_DB_URL=postgresql://postgres.xxxx:<password>@aws-0.xx.pooler.supabase.com:6543/postgres
